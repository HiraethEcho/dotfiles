#!/usr/bin/env bash

set -u

CONFLICT_DIR="$HOME/conflicts"

# 日志文件（留空=不写日志）
LOG_FILE="$HOME/.cache/dcna.log"

# ===== rclone 默认配置（改这里即可自定义）=====
# 并行传输数
DEFAULT_TRANSFERS=50

# 快速 push 的时间窗口（--max-age）
DEFAULT_MAX_AGE="24h"

# 外部过滤器文件（可选；留空=不用）
DEFAULT_FILTER_FROM=""

# 默认 include 过滤（rclone --include，按顺序应用）
DEFAULT_INCLUDE_PATTERNS=(
)

# 默认 exclude 过滤（rclone --exclude）
DEFAULT_EXCLUDE_PATTERNS=(
  ".git/"
  ".venv/"
  "__pycache__/"
  "logs/"
  ".opencode/"
  ".omo/"
  ".mimocode/"
  ".pi/"
  ".claude/"
  ".codex/"
  "themes/"
  "misc/"
  ".trash/"
  "WeChat_Data/"
  "conflicts/"
  "*.log"
  "*.aux"
  "*.fdb_latexmk"
  "*.fls"
  "*.synctex.gz"
  "*.toc"
  "*.out"
  "*.xdv"
  "*.html"
  "*.gitignore"
  "*.gitsubmodule"
  "node_modules/"
  ".obsidian/"
)

GIT_REPO=(
  "$HOME/dotfiles"
  "$HOME/Documents/memex"
)
# "$HOME/Documents/math"
# "$HOME/sites/content"
# "$HOME/Code/docs"

RCLONE_PAIR=(
  "$HOME/Desktop/zotero_files/;koofr:/zotero_files/"
  "$HOME/Documents/papers/;koofr:/papers/"
  "$HOME/Documents/docs/;koofr:/docs/"
  "$HOME/Documents/memex/;koofr:/memex/"
  "$HOME/Documents/memex/;tera:/memex/"
  "$HOME/.local/share/calendar_radicale/;koofr:/asset/radicale-hiraeth-collection/"
  "$HOME/AiKit/;koofr:/AiKit/"
  "$HOME/AiKit/;tera:/AiKit/"
  "$HOME/Documents/morgue/;koofr:/morgue/"
  "$HOME/Documents/morgue/;tera:/morgue/"
)
# "$HOME/Documents/papers/;cst:/papers/"
# "$HOME/Documents/math/;cst:/math/"
# "$HOME/obsidian/;koofr:/obsidian/"
# "$HOME/memex/;tera:/memex/"
# "$HOME/Desktop/zotero_files/;tera:/Documents/zotero_files/"
# "$HOME/Desktop/sorge/;tera:/Documents/sorge/"
# "$HOME/Documents/math/;koofr:/kDocuments/math/"
# "$HOME/Documents/math/;tera:/Documents/math/"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

INTERACTIVE=0
FULL=0
DRY_RUN=0
DELETE_MODE=0
GIT_DIRTY_MODE="skip"   # skip|stop: pull 遇脏仓库跳过或终止
TARGET="all"
POWER_ACTION="none"

# 命令行可覆盖 rclone 配置
TRANSFERS="$DEFAULT_TRANSFERS"
EXTRA_INCLUDE_PATTERNS=()
EXTRA_EXCLUDE_PATTERNS=()
EXTRA_FILTER_FROM=""

DIRTY_GIT_REPOS=()

log_info() { log_to_file "$*"; echo -e "${YELLOW}$*${NC}"; }
log_ok() { log_to_file "$*"; echo -e "${GREEN}$*${NC}"; }
log_err() { log_to_file "$*"; echo -e "${RED}$*${NC}"; }

log_to_file() {
  [ -z "$LOG_FILE" ] && return 0
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >>"$LOG_FILE"
}

show_help() {
  cat <<'EOF'
Usage:
  dcna-lite <command> [options]

Commands:
  day, d              Run pull from rclone + git
  pull, p             Pull backups to local (git/rclone by --target)
  push, P             Push local to backups (git/rclone by --target)
  night, n            Run push + vdsync + power action
  bak, b              Update Arch +  grub + package list backup
  power, u            Run power action
  vdsync, vs          Run: vdirsyncer sync radicale
  config              Show configured repos/pairs/options
  help                Show this help

Options:
  -t, --target <x>    Target: git|rclone|all (aliases: g|r|a; default: all)
  -i, --interactive   Interactive mode (rclone --interactive; paru no --noconfirm)
  -f, --full          Full rclone push (sync mirror, all files)
  -n, --dry-run       Print/preview operations without applying changes
  -d, --delete        Push: delete remote files absent locally (copy mode)
  --git-dirty=mode    Pull: dirty repos = stop|skip (default: skip)
  -u, --power-action  Power action: none|shutdown|reboot (aliases: n|u|r; default: none)
  --include=<pat>     Extra rclone include (repeatable)
  --exclude=<pat>     Extra rclone exclude (repeatable)
  --filter-from=<f>   Extra rclone filter file
  --transfers=<n>     Parallel transfers (default: $DEFAULT_TRANSFERS)
  -h, --help          Show help

Notes:
  - Config editable via DEFAULT_* vars at top of script (filters, transfers, max-age)
  - Log: ~/.cache/dcna.log (set LOG_FILE at top to change)
  - -f/--full only valid for: push|night with --target rclone|all
  - push default mode: copy + --max-age 24h (quick)
  - push full mode: sync mirror (can delete remote-only files)
  - pull with local-protect backup-dir=~/conflicts
EOF
}

show_config() {
  log_info "Current config"
  echo
  echo "GIT_REPO:"
  for repo in "${GIT_REPO[@]}"; do
    echo "  - $repo"
  done
  echo
  echo "RCLONE_PAIR:"
  for pair in "${RCLONE_PAIR[@]}"; do
    echo "  - $pair"
  done
  echo
  echo "Rclone defaults:"
  echo "  - TRANSFERS=$TRANSFERS (default $DEFAULT_TRANSFERS)"
  echo "  - MAX_AGE=$DEFAULT_MAX_AGE"
  echo "  - FILTER_FROM=$DEFAULT_FILTER_FROM"
  echo "  - EXTRA_FILTER_FROM=$EXTRA_FILTER_FROM"
  echo "  - EXTRA_INCLUDE: ${EXTRA_INCLUDE_PATTERNS[*]}"
  echo "  - EXTRA_EXCLUDE: ${EXTRA_EXCLUDE_PATTERNS[*]}"
  echo
  echo "DEFAULT_INCLUDE_PATTERNS:"
  for p in "${DEFAULT_INCLUDE_PATTERNS[@]}"; do echo "  - $p"; done
  echo "DEFAULT_EXCLUDE_PATTERNS:"
  for p in "${DEFAULT_EXCLUDE_PATTERNS[@]}"; do echo "  - $p"; done
  echo
  echo "Options:"
  echo "  - TARGET=$TARGET"
  echo "  - INTERACTIVE=$INTERACTIVE"
  echo "  - FULL=$FULL"
  echo "  - DELETE_MODE=$DELETE_MODE"
  echo "  - GIT_DIRTY_MODE=$GIT_DIRTY_MODE"
  echo "  - DRY_RUN=$DRY_RUN"
  echo "  - POWER_ACTION=$POWER_ACTION"
  echo "  - LOG_FILE=$LOG_FILE"
}

validate_target() {
  case "$TARGET" in
  g) TARGET="git" ;;
  r) TARGET="rclone" ;;
  a | "") TARGET="all" ;;
  esac

  case "$TARGET" in
  git | rclone | all) ;;
  *)
    log_err "Invalid --target: $TARGET"
    exit 1
    ;;
  esac
}

validate_power_action() {
  case "$POWER_ACTION" in
  r) POWER_ACTION="reboot" ;;
  u) POWER_ACTION="shutdown" ;;
  n | "") POWER_ACTION="none" ;;
  esac

  case "$POWER_ACTION" in
  none | shutdown | reboot) ;;
  *)
    log_err "Invalid --power-action: $POWER_ACTION"
    exit 1
    ;;
  esac
}

run_cmd() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: '
    printf '%q ' "$@"
    echo
    return 0
  fi
  "$@"
}

git_pull_all() {
  log_info "Git pull"
  DIRTY_GIT_REPOS=()

  for repo in "${GIT_REPO[@]}"; do
    log_info "Repo: $repo"
    if [ ! -d "$repo/.git" ]; then
      log_err "Skip (not git repo): $repo"
      continue
    fi

    if [ -n "$(git -C "$repo" status --porcelain)" ]; then
      if [ "$GIT_DIRTY_MODE" = "stop" ]; then
        log_err "Stop (dirty tree): $repo"
        exit 1
      fi
      log_err "Skip pull (dirty tree): $repo"
      DIRTY_GIT_REPOS+=("$repo")
      continue
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
      run_cmd git -C "$repo" pull
      continue
    fi

    if git -C "$repo" pull; then
      log_ok "OK pull: $repo"
    else
      log_err "Fail pull: $repo"
    fi
  done

  if [ "${#DIRTY_GIT_REPOS[@]}" -gt 0 ]; then
    log_err "Dirty git repos (skipped):"
    for repo in "${DIRTY_GIT_REPOS[@]}"; do
      echo "  - $repo"
    done
  fi
}

git_push_all() {
  log_info "Git push"
  for repo in "${GIT_REPO[@]}"; do
    log_info "Repo: $repo"
    if [ ! -e "$repo/.git" ]; then
      log_err "Skip (not git repo): $repo"
      continue
    fi

    if [ -z "$(git -C "$repo" status --porcelain)" ]; then
      log_ok "No change: $repo"
      continue
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
      run_cmd git -C "$repo" add .
      run_cmd git -C "$repo" commit -m "backup at $(date +%y/%m/%d-%T)"
      run_cmd git -C "$repo" push
      continue
    fi

    if git -C "$repo" add . &&
      git -C "$repo" commit -m "backup at $(date +%y/%m/%d-%T)" &&
      git -C "$repo" push; then
      log_ok "OK push: $repo"
    else
      log_err "Fail push: $repo"
    fi
  done
}

build_rclone_flags() {
  local -n out_flags=$1
  local pattern
  out_flags=(
    --transfers "$TRANSFERS"
    --progress
    -L
    --track-renames
  )

  # 默认过滤
  for pattern in "${DEFAULT_INCLUDE_PATTERNS[@]}"; do
    out_flags+=(--include "$pattern")
  done
  for pattern in "${DEFAULT_EXCLUDE_PATTERNS[@]}"; do
    out_flags+=(--exclude "$pattern")
  done
  if [ -n "$DEFAULT_FILTER_FROM" ]; then
    out_flags+=(--filter-from "$DEFAULT_FILTER_FROM")
  fi

  # 命令行追加过滤（后应用，可覆盖默认）
  for pattern in "${EXTRA_INCLUDE_PATTERNS[@]}"; do
    out_flags+=(--include "$pattern")
  done
  for pattern in "${EXTRA_EXCLUDE_PATTERNS[@]}"; do
    out_flags+=(--exclude "$pattern")
  done
  if [ -n "$EXTRA_FILTER_FROM" ]; then
    out_flags+=(--filter-from "$EXTRA_FILTER_FROM")
  fi

  if [ "$INTERACTIVE" -eq 1 ]; then
    out_flags+=(--interactive)
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    out_flags+=(--dry-run)
  fi
}

rclone_pull_all() {
  log_info "Rclone pull"
  local flags=()
  local pull_suffix=".local-$(date +%Y%m%d-%H%M%S)"
  build_rclone_flags flags
  run_cmd mkdir -p "$CONFLICT_DIR"

  for pair in "${RCLONE_PAIR[@]}"; do
    IFS=';' read -r local_path remote_path <<<"$pair"
    log_info "Pull: $remote_path -> $local_path"

    if run_cmd rclone sync "$remote_path" "$local_path" "${flags[@]}" --backup-dir "$CONFLICT_DIR" --suffix "$pull_suffix" --suffix-keep-extension; then
      log_ok "OK pull: $remote_path"
    else
      log_err "Fail pull: $remote_path"
    fi

    if [ -d "$CONFLICT_DIR" ]; then
      log_err "Conflicts found: $CONFLICT_DIR"
    fi
  done
}

rclone_push_all() {
  log_info "Rclone push"
  local base_flags=()
  build_rclone_flags base_flags

  for pair in "${RCLONE_PAIR[@]}"; do
    IFS=';' read -r local_path remote_path <<<"$pair"
    log_info "Push: $local_path -> $remote_path"

    if [ "$FULL" -eq 1 ]; then
      if run_cmd rclone sync "$local_path" "$remote_path" "${base_flags[@]}" --suffix-keep-extension; then
        log_ok "OK full push(sync): $remote_path"
      else
        log_err "Fail full push(sync): $remote_path"
      fi
    else
      local push_extra=()
      if [ "$DELETE_MODE" -eq 1 ]; then
        push_extra+=(--delete)
      fi
      if run_cmd rclone copy "$local_path" "$remote_path" "${base_flags[@]}" "${push_extra[@]}" --suffix-keep-extension --no-update-dir-modtime --no-update-modtime --max-age "$DEFAULT_MAX_AGE"; then
        log_ok "OK push(copy): $remote_path"
      else
        log_err "Fail push(copy): $remote_path"
      fi
    fi
  done
}

system_bak() {
  local paru_mode=(--noconfirm)
  local bak_dir="$HOME/Desktop/bak"

  if [ "$INTERACTIVE" -eq 1 ]; then
    paru_mode=()
  fi

  log_info "System update"
  run_cmd paru -Syyu "${paru_mode[@]}" || log_err "Fail: paru -Syyu"

  log_info "Update grub config"
  run_cmd sudo grub-mkconfig -o /boot/grub/grub.cfg || log_err "Fail: grub-mkconfig"

  log_info "Backup package list"
  run_cmd mkdir -p "$bak_dir"
  local qqe_file="$bak_dir/Qqe-$(whoami).bak"
  local qqe_extra="$bak_dir/Qqe-extra-$(whoami).bak"

  if [ -f "$qqe_file" ]; then
    comm -23 <(sort "$qqe_file") <(pacman -Qqe | sort) >>"$qqe_extra"
    sort -u "$qqe_extra" -o "$qqe_extra"
  fi

  run_cmd bash -lc "pacman -Qqe >\"$qqe_file\""
}

run_vdirsyncer() {
  log_info "vdirsyncer sync radicale"
  run_cmd vdirsyncer sync radicale
}

run_power_action() {
  if [ "$DRY_RUN" -eq 1 ]; then
    log_info "DRY-RUN power action: $POWER_ACTION"
    return 0
  fi

  case "$POWER_ACTION" in
  reboot) systemctl reboot ;;
  shutdown) systemctl poweroff -i ;;
  none) echo "Power action: none" ;;
  esac
}

run_night() {
  do_push
  if [ "$TARGET" = "git" ]; then
    run_vdirsyncer
  fi
  system_bak
  run_power_action
}

run_day() {
  do_pull
}

do_pull() {
  case "$TARGET" in
  git) git_pull_all ;;
  rclone) rclone_pull_all ;;
  all)
    rclone_pull_all
    git_pull_all
    ;;
  esac
}

do_push() {
  case "$TARGET" in
  git)
    git_push_all
    ;;
  rclone)
    run_vdirsyncer
    rclone_push_all
    ;;
  all)
    run_vdirsyncer
    rclone_push_all
    git_push_all
    ;;
  esac
}

parse_args() {
  if [ "$#" -eq 0 ]; then
    show_help
    exit 0
  fi

  COMMAND=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    -i | --interactive)
      INTERACTIVE=1
      ;;
    -f | --full)
      FULL=1
      ;;
    -n | --dry-run)
      DRY_RUN=1
      ;;
    --include=*)
      EXTRA_INCLUDE_PATTERNS+=("${1#*=}")
      ;;
    --exclude=*)
      EXTRA_EXCLUDE_PATTERNS+=("${1#*=}")
      ;;
    --filter-from=*)
      EXTRA_FILTER_FROM="${1#*=}"
      ;;
    --transfers=*)
      TRANSFERS="${1#*=}"
      ;;
    -d | --delete)
      DELETE_MODE=1
      ;;
    --git-dirty=*)
      case "${1#*=}" in
      stop | skip) GIT_DIRTY_MODE="${1#*=}" ;;
      *)
        log_err "--git-dirty must be stop or skip"
        exit 1
        ;;
      esac
      ;;
    -t | --target)
      shift
      if [ -z "${1:-}" ]; then
        log_err "Missing value for --target"
        exit 1
      fi
      TARGET="$1"
      ;;
    --target=*)
      TARGET="${1#*=}"
      ;;
    -u | --power | --power-action)
      shift
      if [ -z "${1:-}" ]; then
        log_err "Missing value for --power-action"
        exit 1
      fi
      POWER_ACTION="${1:-}"
      ;;
    --power=*)
      POWER_ACTION="${1#*=}"
      ;;
    --power-action=*)
      POWER_ACTION="${1#*=}"
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        if [ -z "$COMMAND" ]; then
          COMMAND="$1"
        else
          log_err "Unexpected argument: $1"
          show_help
          exit 1
        fi
        shift
      done
      break
      ;;
    -*)
      log_err "Unknown option: $1"
      show_help
      exit 1
      ;;
    *)
      if [ -z "$COMMAND" ]; then
        COMMAND="$1"
      else
        log_err "Unexpected argument: $1"
        show_help
        exit 1
      fi
      ;;
    esac
    shift
  done

  if [ -z "$COMMAND" ]; then
    log_err "Missing command"
    show_help
    exit 1
  fi

  validate_target
  validate_power_action
}

validate_full_usage() {
  if [ "$FULL" -eq 1 ] && [ "$COMMAND" != "push" ] && [ "$COMMAND" != "P" ] && [ "$COMMAND" != "night" ] && [ "$COMMAND" != "n" ]; then
    log_err "--full only valid with push or night command"
    exit 1
  fi

  if [ "$FULL" -eq 1 ] && [ "$TARGET" = "git" ]; then
    log_err "--full not valid with --target git"
    exit 1
  fi

  if [ "$DELETE_MODE" -eq 1 ] && [ "$COMMAND" != "push" ] && [ "$COMMAND" != "P" ] && [ "$COMMAND" != "night" ] && [ "$COMMAND" != "n" ]; then
    log_err "--delete only valid with push or night command"
    exit 1
  fi

  if [ "$DELETE_MODE" -eq 1 ] && [ "$TARGET" = "git" ]; then
    log_err "--delete not valid with --target git"
    exit 1
  fi
}

main() {
  parse_args "$@"
  validate_full_usage
  log_to_file "===== dcna: $COMMAND (target=$TARGET) ====="

  case "$COMMAND" in
  day | d) run_day ;;
  pull | p) do_pull ;;
  push | P) do_push ;;
  night | n) run_night ;;
  bak | b) system_bak ;;
  power | u) run_power_action ;;
  vdsync | vs) run_vdirsyncer ;;
  config) show_config ;;
  help) show_help ;;
  *)
    log_err "Unknown command: $COMMAND"
    show_help
    exit 1
    ;;
  esac
}

main "$@"
