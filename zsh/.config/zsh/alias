# misc
alias quit="exit"
alias lc='git rev-parse --show-toplevel >/dev/null 2>&1 && find "$(git rev-parse --show-toplevel)" -type f \( -name "*.aux" -o -name "*.log" -o -name "*.toc" -o -name "*.lof" -o -name "*.lot" -o -name "*.out" -o -name "*.bbl" -o -name "*.blg" -o -name "*.synctex.gz" -o -name "*.fls" -o -name "*.xdv" -o -name "*.fdb_latexmk" \) -delete'
